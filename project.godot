; BQ Sqwad Game — Landly City
; Godot 4.7.2 stable
; Initial production foundation: Phase 1 prototype

config_version=5

[application]
config/name="BQ Sqwad Game"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.08, 1)

[input]
move_forward={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]}
move_back={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]}
jump={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":32)]}
interact={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":69)]}
attack={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":70)]}
